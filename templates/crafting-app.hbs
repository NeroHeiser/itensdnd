<div class="itensdnd-workshop-container flexcol">
  <!-- Top Bar: Ator e Filtros -->
  <header class="workshop-header flexrow">
    <div class="actor-select-group flexrow">
      <label><i class="fas fa-user"></i> {{localize "ITENSDND.Workshop.Actor"}}:</label>
      <select name="selectedActor" data-action="selectActor">
        {{#each actors}}
          <option value="{{this.id}}" {{#if (eq this.id ../actor.id)}}selected{{/if}}>{{this.name}}</option>
        {{/each}}
      </select>
    </div>

    <div class="filter-group flexrow">
      <label class="checkbox-label">
        <input type="checkbox" name="craftableOnly" {{#if craftableOnly}}checked{{/if}} data-action="toggleFilter"/>
        {{localize "ITENSDND.Workshop.Filters.CraftableOnly"}}
      </label>
    </div>
  </header>

  <!-- Abas de Profissão -->
  <nav class="profession-tabs flexrow">
    {{#each professions}}
      <button type="button" class="profession-tab-btn {{#if (eq this.key ../activeProfession)}}active{{/if}}"
              data-action="changeProfession" data-profession="{{this.key}}">
        <i class="{{this.icon}}"></i> {{this.label}}
      </button>
    {{/each}}
  </nav>

  <!-- Conteúdo Principal em Duas Colunas -->
  <div class="workshop-body flexrow">
    <!-- Coluna da Esquerda: Lista de Receitas -->
    <aside class="recipes-sidebar flexcol">
      <div class="search-box">
        <i class="fas fa-search"></i>
        <input type="text" placeholder="{{localize 'ITENSDND.Workshop.Filters.SearchPlaceholder'}}" value="{{searchQuery}}" name="searchQuery"/>
      </div>

      <ul class="recipes-list">
        {{#each recipes}}
          <li class="recipe-item flexrow {{#if (eq (or this.id this.key) (or ../selectedRecipe.id ../selectedRecipe.key))}}selected{{/if}}"
              data-action="selectRecipe" data-recipe-id="{{or this.id this.key}}">
            <img src="{{this.img}}" width="32" height="32" />
            <div class="recipe-info flexcol">
              <span class="recipe-name">{{this.name}}</span>
              <span class="recipe-meta">CD {{this.dc}} | {{this.time}}h</span>
            </div>
            <span class="rarity-tag {{this.rarity}}">{{this.rarity}}</span>
          </li>
        {{else}}
          <li class="empty-list">Nenhuma receita encontrada.</li>
        {{/each}}
      </ul>
    </aside>

    <!-- Coluna da Direita: Detalhes da Receita Selecionada -->
    <main class="recipe-detail-panel flexcol">
      {{#if selectedRecipe}}
        <header class="detail-header flexrow">
          <img src="{{selectedRecipe.img}}" width="48" height="48" class="detail-icon"/>
          <div class="detail-title flexcol">
            <h2>{{selectedRecipe.name}}</h2>
            <div class="detail-meta-tags flexrow">
              <span class="badge dc-badge">CD {{selectedRecipe.dc}}</span>
              <span class="badge time-badge"><i class="fas fa-clock"></i> {{selectedRecipe.time}} {{localize "ITENSDND.Workshop.Recipe.Hours"}}</span>
              <span class="badge rarity-badge {{selectedRecipe.rarity}}">{{selectedRecipe.rarity}}</span>
              <span class="badge tool-badge"><i class="fas fa-wrench"></i> {{selectedRecipe.tool}}</span>
            </div>
          </div>
        </header>

        <!-- Modificador do Personagem -->
        <section class="crafting-mod-box flexrow">
          <div class="mod-pill">
            <span class="mod-label">Modificador de Criação:</span>
            <span class="mod-value">{{#if (gte craftingMod.mod 0)}}+{{/if}}{{craftingMod.mod}}</span>
          </div>
          <div class="mod-desc">
            (Proficiência: +{{craftingMod.profBonus}} | Atributo: {{craftingMod.bestAbility}} +{{craftingMod.abilityMod}})
          </div>
        </section>

        <!-- Lista de Materiais -->
        <section class="materials-section">
          <h3><i class="fas fa-boxes"></i> {{localize "ITENSDND.Workshop.Recipe.Materials"}}</h3>
          <ul class="materials-checklist">
            {{#each materialsStatus}}
              <li class="material-req-item flexrow {{#if this.satisfied}}satisfied{{else}}missing{{/if}}">
                <i class="fas {{#if this.satisfied}}fa-check-circle{{else}}fa-times-circle{{/if}}"></i>
                <span class="material-key">{{this.key}}</span>
                <span class="material-quantities">{{this.have}} / {{this.needed}}</span>
              </li>
            {{/each}}
          </ul>
        </section>

        <!-- Barra de Progresso do Projeto Ativo -->
        <section class="progress-section flexcol">
          <div class="progress-labels flexrow">
            <span><strong>{{localize "ITENSDND.Workshop.Recipe.Progress"}}:</strong> {{progress.hours}} / {{progress.total}} {{localize "ITENSDND.Workshop.Recipe.Hours"}} ({{progress.percent}}%)</span>
            {{#if (gt progress.consecutiveFailures 0)}}
              <span class="failures-warn"><i class="fas fa-exclamation-triangle"></i> Falhas: {{progress.consecutiveFailures}}/3</span>
            {{/if}}
          </div>
          <div class="progress-bar-outer">
            <div class="progress-bar-inner" style="width: {{progress.percent}}%;"></div>
          </div>
        </section>

        <!-- Botões de Ação -->
        <footer class="action-buttons-footer flexrow">
          <button type="button" class="btn-action roll-btn" data-action="rollAttempt">
            <i class="fas fa-dice-d20"></i> {{localize "ITENSDND.Workshop.Recipe.Roll2Hours"}}
          </button>

          <button type="button" class="btn-action take10-btn" data-action="take10">
            <i class="fas fa-shield-alt"></i> {{localize "ITENSDND.Workshop.Recipe.Take10"}} ({{multiply selectedRecipe.time 2}}h)
          </button>

          {{#if (gt progress.hours 0)}}
            <button type="button" class="btn-action reset-btn" data-action="resetProject">
              <i class="fas fa-undo"></i> {{localize "ITENSDND.Workshop.Recipe.ResetProgress"}}
            </button>
          {{/if}}
        </footer>

      {{else}}
        <div class="no-recipe-selected">
          <p>Selecione uma receita à esquerda para visualizar os detalhes e iniciar a criação.</p>
        </div>
      {{/if}}
    </main>
  </div>
</div>
